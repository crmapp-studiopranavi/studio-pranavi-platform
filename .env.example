# Glass & Lighting Business Platform — Environment Variables
# Copy this file to .env.local at the root and populate each value.
# NEVER commit .env.local, .env, or any file containing real secrets.

# ─── Supabase (shared backend) ────────────────────────────────────────────────
# Public project URL — safe to embed in browser builds
VITE_SUPABASE_URL=

# Public anon key — safe to embed in browser builds (RLS enforces security)
VITE_SUPABASE_ANON_KEY=

# Service-role key — NEVER put this in any frontend app, use only in
# server-side code, edge functions, or CI/CD pipelines
SUPABASE_SERVICE_ROLE_KEY=

# ─── Application URLs ─────────────────────────────────────────────────────────
# Public-facing website URL (e.g. https://www.yourdomain.com)
VITE_PUBLIC_SITE_URL=

# CRM application URL (e.g. https://crm.yourdomain.com)
VITE_CRM_URL=

# ─── Supabase Auth redirect URLs ──────────────────────────────────────────────
# Must be registered in Supabase Auth → URL Configuration → Redirect URLs
VITE_AUTH_REDIRECT_URL=

# ─── Contact / configurable business actions ──────────────────────────────────
# WhatsApp number in international format without + (e.g. 919876543210)
# Used for the website's WhatsApp CTA — not hard-coded
VITE_WHATSAPP_NUMBER=

# Click-to-call phone number displayed on the website
VITE_CONTACT_PHONE=

# ─── Branding overrides (optional) ───────────────────────────────────────────
# Override the logo URL served to the website (default variant)
VITE_LOGO_URL=

# Override the light/reversed logo URL (for dark backgrounds)
VITE_LOGO_LIGHT_URL=

# Contact email shown on the public website (safe to expose)
VITE_CONTACT_EMAIL=

# ─── Optional: anti-abuse (Phase 3) ───────────────────────────────────────────
# Cloudflare Turnstile site key — public, safe in browser builds
VITE_TURNSTILE_SITE_KEY=

# Turnstile secret key — server/edge only
TURNSTILE_SECRET_KEY=

# ─── Optional: notification provider (Phase 3) ────────────────────────────────
# Add keys for email (Resend, SendGrid, etc.) or WhatsApp Business API
# when the notification_outbox integration is implemented.
# Keep these out of all frontend code.
# NOTIFICATION_API_KEY=
# NOTIFICATION_WHATSAPP_TOKEN=
